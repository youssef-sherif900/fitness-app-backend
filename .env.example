# --- App ---
APP_NAME="Fitness API"
APP_ENV=local
APP_DEBUG=true
# Dev-only key. Generate a new one for any shared environment: php artisan key:generate --show
APP_KEY=base64:AoaaCLES5gCgvuYoHg02zpQpQxKE192xwx+rgIL4aVY=
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Local ports ---
API_PORT=8080
WS_PORT=8081
S3_PORT=8333
MAILPIT_PORT=8025

# --- PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fitness
DB_USERNAME=app
DB_PASSWORD=app_dev_password

# --- Redis (cache, queues, pub/sub, presence, rate limits) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# --- Object storage (SeaweedFS S3 API; credentials must match docker/seaweedfs/s3.json) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=fitness_dev_access
AWS_SECRET_ACCESS_KEY=fitness_dev_secret_change_me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fitness-media
AWS_ENDPOINT=http://seaweedfs:8333
AWS_USE_PATH_STYLE_ENDPOINT=true
# Endpoint embedded in signed upload/playback URLs. Set to http://<your-LAN-IP>:8333 to upload from a real phone.
AWS_PUBLIC_ENDPOINT=http://localhost:8333

# --- Reverb (WebSockets) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=fitness-local
REVERB_APP_KEY=fitness-local-key
REVERB_APP_SECRET=fitness-local-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true

# --- Mail (Mailpit in the dev profile) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@fitness.local
MAIL_FROM_NAME="Fitness App"

# --- Fitness domain config (placeholders: MUST be reviewed by a qualified nutrition professional) ---
FITNESS_MIN_DAILY_KCAL=1200
FITNESS_MAX_WEEKLY_LOSS_PCT=1.0
FITNESS_PROTEIN_G_PER_KG=1.8
FITNESS_FAT_PCT=0.25
FITNESS_ACCOUNT_DELETION_DAYS=30

# --- Media limits ---
MEDIA_VOICE_MAX_SECONDS=180
MEDIA_VIDEO_MAX_SECONDS=60
MEDIA_VIDEO_MAX_MB=50

# --- Social sign-in (AUTH-2): set to your OAuth client IDs ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
